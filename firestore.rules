rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid}/moments/{id} {
   allow read, delete: if request.auth != null && request.auth.uid == uid;
   allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.owner == uid && request.resource.data.keys().hasOnly(['name','created','width','height','bytes','recordingType','hasRecording','owner']) && request.resource.data.name is string && request.resource.data.name.size() <= 120;
   allow update: if request.auth != null && request.auth.uid == uid && request.resource.data == resource.data;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
