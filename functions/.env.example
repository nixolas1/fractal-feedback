# Exact additional HTTPS origins, comma-separated. Default Firebase Hosting origins are already allowed.
ALLOWED_ORIGINS=https://installation.example.org
# Same-Wi-Fi/direct connections are the default and require no Twilio account.
# To add optional TURN relaying: set twilio, create both Twilio secrets, then redeploy Functions.
TURN_PROVIDER=none
# Emulator only, if its signed-asset proxy must be reached from another device.
# EMULATOR_PUBLIC_HOST=192.168.1.10
