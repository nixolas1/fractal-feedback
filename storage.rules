rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /users/{uid}/moments/{moment}/{file} {
   allow read: if request.auth != null && request.auth.uid == uid;
   allow create: if resource == null && request.auth != null && request.auth.uid == uid && request.resource.size < 1024 * 1024 * 1024 && file in ['moment.feedback','thumbnail.png','recording'];
   allow delete: if request.auth != null && request.auth.uid == uid;
   allow update: if false;
  }
  match /{allPaths=**} { allow read, write: if false; }
 }
}
