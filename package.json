{
  "name": "feedback-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:rules": "npm_config_cache=.cache/firebase-npm npx -y firebase-tools@latest emulators:exec --project demo-feedback --only database,firestore,storage 'vitest run tests/firebase.rules.test.ts'",
    "typecheck": "tsc -b",
    "mcp": "node mcp/dist/mcp/src/index.js",
    "build:functions": "tsc -p functions/tsconfig.json",
    "dev:emulator": "vite --host 0.0.0.0 --mode emulator --port 5174",
    "test:cloud": "FEEDBACK_CLOUD_TEST=1 playwright test tests/cloud.spec.ts",
    "test:offline": "node tests/offline.mjs",
    "test:webkit": "node tests/webkit.mjs",
    "format": "prettier --write src functions/src mcp/src tests docs *.ts *.json README.md",
    "check": "pnpm typecheck && pnpm test && pnpm build:functions && tsc -p mcp/tsconfig.json",
    "build:mcp": "tsc -p mcp/tsconfig.json",
    "deploy": "pnpm check && pnpm build && npm_config_cache=.cache/firebase-npm npx -y firebase-tools@latest deploy --project fractal-feedback",
    "firebase:configure": "node scripts/firebase-config.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@xyflow/react": "^12.8.2",
    "fflate": "^0.8.2",
    "firebase": "^12.1.0",
    "gifuct-js": "^2.1.2",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
